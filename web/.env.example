# Everything here is optional. On first visit the app asks for your library
# folder(s) and a password and stores them itself; this file is for managing
# them from the environment instead.

# Absolute path(s) to folders containing your RJ-coded work directories.
# Multiple paths can be configured in Settings (one per line), or here using the
# OS path separator (`:` on Linux/macOS, `;` on Windows). A value in Settings
# wins over this one.
# KIKOERU_LIBRARY_ROOT=/absolute/path/to/your/library

# Login password. When set it always wins, and the in-app password form is
# hidden. Unset, you choose one on first visit (stored as a hash in
# <DATA_DIR>/password; delete that file to reset it).
# KIKOERU_PASSWORD=

# Optional: override the session-cookie signing key. If unset, a random 32-byte
# secret is generated on first run and persisted to <DATA_DIR>/session-secret.
# KIKOERU_SESSION_SECRET=

# Optional: where the SQLite database lives (default: ../data relative to web/)
# KIKOERU_DATA_DIR=/absolute/path/to/data

# Optional: where cached cover images are stored (default: <project-root>/covers)
# KIKOERU_COVERS_DIR=/absolute/path/to/covers

# Optional: force the login cookie's Secure flag (true/false). Unset, it is
# Secure over HTTPS and plain over http://<lan-ip>, decided per request.
# KIKOERU_SECURE_COOKIES=
