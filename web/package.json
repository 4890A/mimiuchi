{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "scan": "tsx --tsconfig scripts/tsconfig.json --env-file=.env.local scripts/scan.ts",
    "backup": "tsx --tsconfig scripts/tsconfig.json --env-file=.env.local scripts/backup.ts",
    "restore": "tsx --tsconfig scripts/tsconfig.json --env-file=.env.local scripts/restore.ts",
    "test": "tsx --tsconfig scripts/tsconfig.json --test \"src/**/*.test.ts\"",
    "test:fixtures": "tsx --tsconfig scripts/tsconfig.json scripts/capture-fixtures.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "iron-session": "^8.0.4",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "lucide-react": "^1.16.0",
    "minisearch": "^7.2.0",
    "music-metadata": "^11.12.3",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.7.0",
    "sharp": "^0.35.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.10.0",
    "wanakana": "^5.3.1",
    "wavesurfer.js": "^7.12.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.26",
      "sharp": "^0.35.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
