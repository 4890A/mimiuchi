{
  "name": "web",
  "version": "0.2.1",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "scan": "tsx --tsconfig scripts/tsconfig.json --env-file=.env.local scripts/scan.ts",
    "backup": "tsx --tsconfig scripts/tsconfig.json --env-file=.env.local scripts/backup.ts",
    "restore": "tsx --tsconfig scripts/tsconfig.json --env-file=.env.local scripts/restore.ts",
    "test": "tsx --tsconfig scripts/tsconfig.json --test \"src/**/*.test.ts\"",
    "package:windows": "pwsh -NoProfile -File ../packaging/windows/build.ps1",
    "test:fixtures": "tsx --tsconfig scripts/tsconfig.json scripts/capture-fixtures.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^8.0.4",
    "kuroshiro": "^1.2.1",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "lucide-react": "^1.70.0",
    "minisearch": "^7.2.0",
    "music-metadata": "^11.16.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.12.4",
    "wanakana": "^5.3.1",
    "wavesurfer.js": "^7.12.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.26",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "sharp": "^0.35.5"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
