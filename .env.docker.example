# Host-side settings for compose.yaml. Copy this file to `.env` in the repo
# root (gitignored). Only Docker Compose reads it; the app itself never does,
# so it cannot clash with web/.env.local.

# Absolute host path to the folder of RJ-coded works (required).
#   Windows: MIMIUCHI_LIBRARY=D:/Audio/works   (forward slashes are fine)
#   Linux:   MIMIUCHI_LIBRARY=/srv/audio/works
MIMIUCHI_LIBRARY=

# Host port to publish the app on.
MIMIUCHI_PORT=3000

# Optional login password. Leave it unset and the app asks you to choose one
# on first visit (stored in the data volume, changeable in Settings). Set it
# here to manage it from this file instead; it then wins over the in-app one.
#KIKOERU_PASSWORD=

# Optional: pin the cookie signing key instead of generating one into /data.
#KIKOERU_SESSION_SECRET=

# Optional: force the login cookie's Secure flag. Unset, it follows the request's
# scheme, which is right for both plain LAN HTTP and a proxy that sends
# X-Forwarded-Proto (see compose.yaml).
#KIKOERU_SECURE_COOKIES=

#TZ=Asia/Tokyo
