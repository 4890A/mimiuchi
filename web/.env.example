# Required: absolute path to the folder containing your RJ-coded work directories
KIKOERU_LIBRARY_ROOT=/absolute/path/to/your/library

# Required: shared password used to log in (any non-empty string)
KIKOERU_PASSWORD=changeme

# Optional: override the session-cookie signing key. If unset, a random 32-byte
# secret is generated on first run and persisted to <DATA_DIR>/session-secret.
# KIKOERU_SESSION_SECRET=

# Optional: where the SQLite database lives (default: ../data relative to web/)
# KIKOERU_DATA_DIR=/absolute/path/to/data

# Optional: where cached cover images are stored (default: <project-root>/covers)
# KIKOERU_COVERS_DIR=/absolute/path/to/covers
